+++ b/android/app/src/main/java/com/landosol/toolbox/protocol/bilibili/AndroidGameClientLocator.kt
@@ -0,0 +1,55 @@
+package com.landosol.toolbox.protocol.bilibili
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+
+data class InstalledGameClient(val packageName: String, val server: GameServer)
+
+/** Exact client identifiers observed in the local LDPlayer application catalogue. */
+object PcrGamePackages {
+    const val BILIBILI = "com.bilibili.priconne"
+    val knownPackages: Map<String, GameServer> = linkedMapOf(
+        BILIBILI to GameServer.CN_BILIBILI,
+        "com.bilibili.priconne.huawei" to GameServer.CN_HUAWEI,
+        "com.bilibili.priconne.vivo" to GameServer.CN_VIVO,
+        "com.bilibili.priconne.nearme.gamecenter" to GameServer.CN_OPPO,
+        "com.bilibili.priconne.mi" to GameServer.CN_XIAOMI,
+        "com.bilibili.priconne.aligames" to GameServer.CN_ALIGAMES,
+        "com.bilibili.priconne.m4399" to GameServer.CN_4399,
+        "com.tencent.tmgp.bilibili.priconne" to GameServer.CN_TENCENT,
+        "com.bilibili.priconne.yofun.mumu" to GameServer.CN_MUMU,
+    )
+    fun classify(packageName: String?): GameServer? = knownPackages[packageName]
+}
+
+class AndroidGameClientLocator(context: Context) {
+    private val packageManager = context.applicationContext.packageManager
+    @Volatile private var activePackage: String? = null
+    fun isSupportedGamePackage(packageName: String?): Boolean = PcrGamePackages.classify(packageName) != null
+    fun isActiveGamePackage(packageName: String?): Boolean = packageName != null && packageName == activePackage
+    fun findInstalled(server: GameServer): InstalledGameClient? = installedClients().filter {
+        it.server == server || (server == GameServer.CN_CHANNEL && it.server.isChannel)
+    }.singleOrNull()
+    fun launchIntent(server: GameServer): Intent? {
+        activePackage = null
+        val client = findInstalled(server) ?: return null
+        val intent = packageManager.getLaunchIntentForPackage(client.packageName) ?: return null
+        activePackage = client.packageName
+        return intent
+    }
+    /** Reset must return to the same client even if the selected account has changed. */
+    fun relaunchIntent(): Intent? = activePackage?.let(packageManager::getLaunchIntentForPackage)
+    fun installedClients(): List<InstalledGameClient> = PcrGamePackages.knownPackages.mapNotNull { (name, server) ->
+        if (isInstalled(name)) InstalledGameClient(name, server) else null
+    }
+    private fun isInstalled(name: String): Boolean = runCatching {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            packageManager.getPackageInfo(name, PackageManager.PackageInfoFlags.of(0))
+        } else {
+            @Suppress("DEPRECATION")
+            packageManager.getPackageInfo(name, 0)
+        }
+    }.isSuccess
+}
